# Frontend development settings (read by vite.config.ts from the process
# environment — export them or put them in your shell profile; nothing here is
# shipped to the browser and there are no secrets).

# Where the Vite dev/preview server proxies /api requests.
# Docker Compose sets this to http://backend:3000.
API_PROXY_TARGET=http://localhost:3000

# Base URL for Playwright end-to-end tests.
E2E_BASE_URL=http://localhost:5173
